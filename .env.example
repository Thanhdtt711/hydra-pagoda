# Vạn Cảnh Thiền Tự - biến môi trường (sao chép thành .env, KHÔNG commit .env)
# Chỉ biến có tiền tố NUXT_PUBLIC_ được gửi xuống trình duyệt.

# Mạng Cardano: preprod (testnet, mặc định) hoặc mainnet. Chỉ đổi sang mainnet sau khi duyệt.
NUXT_PUBLIC_CARDANO_NETWORK=preprod

# Đường dẫn file SQLite (tự tạo thư mục). Backup bằng cách sao chép file khi tắt server hoặc dùng `sqlite3 .backup`.
NUXT_DB_PATH=./.data/pagoda.sqlite

# Thời hạn phiên đăng nhập (giờ). 168 = 7 ngày.
NUXT_SESSION_TTL_HOURS=168

# Bật true CHỈ khi chạy sau reverse proxy tin cậy (nginx/Caddy) để tin X-Forwarded-*.
NUXT_TRUST_PROXY=false

# --- Bước 3: Mua MC coin bằng ADA ---
# Địa chỉ ví treasury nhận ADA (chỉ địa chỉ nhận bech32, KHÔNG BAO GIỜ đặt khóa riêng/seed vào đây).
# Trên Preprod nếu để trống sẽ dùng địa chỉ testnet mẫu; trên Mainnet BẮT BUỘC phải cấu hình.
NUXT_TREASURY_ADDRESS=

# Blockfrost project key (chỉ ở server). Lấy tại https://blockfrost.io
NUXT_BLOCKFROST_API_KEY=

# Tùy chọn ghi đè URL Blockfrost (để trống sẽ tự suy theo mạng preprod / mainnet)
NUXT_BLOCKFROST_BASE_URL=

# Số xác nhận tối thiểu trên chuỗi trước khi cộng MC (0 = tự chọn: 1 cho Preprod, 3 cho Mainnet)
NUXT_CONFIRMATIONS_REQUIRED=0

# Thời hạn đơn mua MC (phút, mặc định 30)
NUXT_ORDER_TTL_MINUTES=30

# Nhãn metadata giao dịch chứa orderId (mặc định 8181)
NUXT_ORDER_METADATA_LABEL=8181

# Bí mật xác thực Blockfrost Webhook (tùy chọn)
NUXT_WEBHOOK_SECRET=
