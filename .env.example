# Vạn Cảnh Thiền Tự - biến môi trường (sao chép thành .env, KHÔNG commit .env)
# Chỉ biến có tiền tố NUXT_PUBLIC_ được gửi xuống trình duyệt.

# Mạng Cardano: preprod (testnet, mặc định) hoặc mainnet. Chỉ đổi sang mainnet sau khi duyệt.
NUXT_PUBLIC_CARDANO_NETWORK=preprod

# PostgreSQL / Supabase (khuyên dùng Session pooler trên Render). Để trống sẽ dùng SQLite cục bộ.
DATABASE_URL=

# Đường dẫn file SQLite (khi không dùng DATABASE_URL).
NUXT_DB_PATH=./.data/pagoda.sqlite

# Thời hạn phiên đăng nhập (giờ). 168 = 7 ngày.
NUXT_SESSION_TTL_HOURS=168

# Bật true CHỈ khi chạy sau reverse proxy tin cậy (nginx/Caddy) để tin X-Forwarded-*.
NUXT_TRUST_PROXY=false

# --- Bước 3: Mua MC coin bằng ADA ---
# Địa chỉ ví treasury nhận ADA (chỉ địa chỉ nhận bech32, KHÔNG BAO GIỜ đặt khóa riêng/seed vào đây).
# Trên Preprod nếu để trống sẽ dùng địa chỉ testnet mẫu; trên Mainnet BẮT BUỘC phải cấu hình.
NUXT_TREASURY_ADDRESS=

# Blockfrost project key (chỉ ở server). Lấy tại https://blockfrost.io
NUXT_BLOCKFROST_API_KEY=

# Tùy chọn Koios Bearer token nếu dùng Koios thay vì Blockfrost (lấy tại https://koios.rest)
NUXT_KOIOS_API_TOKEN=

# Tùy chọn ghi đè URL Blockfrost (để trống sẽ tự suy theo mạng preprod / mainnet)
NUXT_BLOCKFROST_BASE_URL=

# Số xác nhận tối thiểu trên chuỗi trước khi cộng MC (0 = tự chọn: 1 cho Preprod, 3 cho Mainnet)
NUXT_CONFIRMATIONS_REQUIRED=0

# Thời hạn đơn mua MC (phút, mặc định 30)
NUXT_ORDER_TTL_MINUTES=30

# Nhãn metadata giao dịch chứa orderId (mặc định 8181)
NUXT_ORDER_METADATA_LABEL=8181

# Bí mật xác thực Blockfrost Webhook (tùy chọn)
NUXT_WEBHOOK_SECRET=

# --- Hydra L2 (Hybrid: SQLite vẫn là sổ cái chính, Hydra Head là lớp chứng thực UTxO) ---
# Bật phản chiếu mọi bút toán MC lên Hydra Head khi hydra-node đang Open. Tắt/mất kết nối => tự động fallback SQLite.
HYDRA_L2_ENABLED=false
# WebSocket API của hydra-node (hydra-node offline qua Docker: `npm run hydra:prepare` rồi `npm run hydra:up`; cổng bận thì dùng HYDRA_API_PORT=4002 và ws://127.0.0.1:4002)
HYDRA_NODE_WS_URL=ws://127.0.0.1:4001
# Bí mật dẫn xuất Session Key/Fuel Key (để trống: tự sinh một lần và lưu trong bảng hydra_kv). KHÔNG commit giá trị thật.
NUXT_HYDRA_SESSION_SECRET=
# Lovelace khóa trong State UTxO của mỗi tài khoản trên L2 (mặc định 2 ADA)
NUXT_HYDRA_STATE_LOVELACE=2000000
# Số UTxO mồi (Fuel Pool) mong muốn trong Head
NUXT_HYDRA_FUEL_TARGET=10
# Thời gian chờ TxValid cho mỗi NewTx (ms)
NUXT_HYDRA_SUBMIT_TIMEOUT_MS=8000

# --- NPC Thầy Trụ Trì (Google Gemini / OpenAI-compatible + RAG từ thư mục data/) ---
# Tùy chọn API key (để trống = chạy chế độ RAG offline chuẩn hóa từ data/). KHÔNG điền key thật vào .env.example.
NUXT_ABBOT_LLM_API_KEY=
NUXT_ABBOT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
NUXT_ABBOT_LLM_MODEL=gemini-2.5-flash
